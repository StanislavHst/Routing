@model IEnumerable<Product>
@{
    ViewData["Title"] = "Products";
}
<h1>Products</h1>
<p><a asp-action="Create">Create New</a></p>
<form method="get" asp-action="Index" class="mb-3">
    <label for="filterId">ID</label>
    <input id="filterId" name="filterId" type="number" value="@Context.Request.Query["filterId"]" />
    <label for="filtername">Name</label>
    <input id="filtername" name="filtername" value="@Context.Request.Query["filtername"]" />
    <button type="submit">Filter</button>
    <a asp-action="Index">Reset</a>
</form>
<table class="table">
    <tr><th>ID</th><th>Name</th><th>Description</th><th>Actions</th></tr>
    @foreach (var product in Model)
    {
        <tr>
            <td>@product.Id</td><td>@product.Name</td><td>@product.Description</td>
            <td>
                <a asp-action="Edit" asp-route-id="@product.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@product.Id">View</a> |
                <a asp-action="Delete" asp-route-id="@product.Id">Delete</a>
            </td>
        </tr>
    }
</table>
